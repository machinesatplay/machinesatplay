{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "game.schema.json",
  "title": "Game project",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "engineVersion"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1,
      "default": 1
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$"
    },
    "engineVersion": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9._-]+$"
    }
  }
}
